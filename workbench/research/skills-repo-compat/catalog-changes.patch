+// Generated by CMake from cmake/version.h.in — the ONLY place the version
+// string enters C++. Lives in the build tree (generated/app/version.h); never
+// commit the generated file. Source of truth: the VERSION file next to
+// CMakeLists.txt. Written 2026-10-13; not compiled in the authoring sandbox.
+#pragma once
+
+#define APP_VERSION_STRING "@APP_VERSION@"
+#define APP_VERSION_MAJOR  @PROJECT_VERSION_MAJOR@
+#define APP_VERSION_MINOR  @PROJECT_VERSION_MINOR@
+#define APP_VERSION_PATCH  @PROJECT_VERSION_PATCH@
+
+namespace app::version {
+inline constexpr const char* string = APP_VERSION_STRING;
+inline constexpr int major = APP_VERSION_MAJOR;
+inline constexpr int minor = APP_VERSION_MINOR;
+inline constexpr int patch = APP_VERSION_PATCH;
+}  // namespace app::version
diff --git a/coding-agents/variants/qt6-cmake-cpp/templates/github-workflow-qt.yml b/coding-agents/variants/qt6-cmake-cpp/templates/github-workflow-qt.yml
new file mode 100644
index 0000000..c39a4dd
--- /dev/null
+++ b/coding-agents/variants/qt6-cmake-cpp/templates/github-workflow-qt.yml
@@ -0,0 +1,117 @@
+# GitHub Actions skeleton for a Qt 6 / CMake desktop app — Linux + Windows.
+#
+# What it proves (and only this): compile on both lanes, core unit tests, the
+# offscreen GUI harness, a packaged artifact with an asserted manifest, and a
+# fresh-runner smoke of that artifact. It does NOT prove a clean consumer
+# machine or any physical-desktop behaviour (keep a dated runsheet for those).
+#
+# Before use: replace <QT_VERSION>, pin runner labels and action majors
+# deliberately (check the action's declared runtime, not just the tag), and
+# keep any mirrored copy of this file byte-identical.
+#
+# Written 2026-10-13; not executed in the authoring sandbox.
+
+name: Build and test
+
+on:
+  push:
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}
+
+jobs:
+  linux:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 40
+    steps:
+      - uses: actions/checkout@v5
+      - name: Install Qt 6 (system packages)
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends qt6-base-dev ninja-build
+      - name: Configure (fresh build dir, warnings as errors)
+        run: cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DWARNINGS_AS_ERRORS=ON
+      - name: Source tree untouched by configure
+        run: git status --porcelain | tee /dev/stderr | grep -q . && { echo "::error::configure wrote into the source tree"; exit 1; } || true
+      - name: Build
+        run: cmake --build build --parallel
+      - name: Core unit tests
+        run: ctest --test-dir build --output-on-failure -R '^core$'
+      - name: GUI offscreen harness (a crash prints no FAIL lines — check the exit status)
+        env:
+          QT_QPA_PLATFORM: offscreen
+          APP_TEST_FIXTURES: ${{ github.workspace }}/build/fixtures
+        run: |
+          test -x build/test_gui_offscreen || { echo "::error::harness binary missing (Qt not found at configure?)"; exit 1; }
+          set -o pipefail
+          build/test_gui_offscreen 2>&1 | tee build/gui_offscreen.log
+      - name: ASan + UBSan lane (debug)
+        run: |
+          cmake -S . -B build-asan -G Ninja -DCMAKE_BUILD_TYPE=Debug -DENABLE_ASAN=ON -DENABLE_UBSAN=ON -DBUILD_GUI=OFF
+          cmake --build build-asan --parallel
+          ASAN_OPTIONS=detect_leaks=0 ctest --test-dir build-asan --output-on-failure
+      - name: Lint (Qt anti-patterns; baseline accepted findings live in the repo)
+        run: python3 scripts/qt_lint.py src tests CMakeLists.txt --baseline qt_lint.baseline.json
+
+  windows:
+    runs-on: windows-2022
+    timeout-minutes: 60
+    defaults: { run: { shell: bash } }
+    steps:
+      - uses: actions/checkout@v5
+      - name: Install Qt 6 + MinGW (aqt)
+        run: |
+          pip install aqtinstall
+          aqt install-qt windows desktop <QT_VERSION> win64_mingw -O "$RUNNER_TEMP/qt"
+          aqt install-tool windows desktop tools_mingw1310 -O "$RUNNER_TEMP/qt"
+          QT_PREFIX=$(ls -d "$RUNNER_TEMP"/qt/6.*/mingw_64)
+          echo "QT_PREFIX=$QT_PREFIX" >> "$GITHUB_ENV"
+          echo "$QT_PREFIX/bin" >> "$GITHUB_PATH"
+          ls -d "$RUNNER_TEMP"/qt/Tools/mingw*/bin >> "$GITHUB_PATH"
+      - name: Toolchain identity (diagnostic only)
+        run: g++ --version; cmake --version; qmake6 -v || true
+      - name: Configure + build (MinGW, Ninja)
+        run: |
+          cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH="$QT_PREFIX"
+          cmake --build build --parallel
+      - name: Core unit tests (4-byte long here — the LLP64 class)
+        run: ctest --test-dir build --output-on-failure -R '^core$'
+      - name: GUI offscreen harness
+        env:
+          QT_QPA_PLATFORM: offscreen
+          APP_TEST_FIXTURES: ${{ github.workspace }}/build/fixtures
+        run: |
+          test -x build/test_gui_offscreen.exe || { echo "::error::harness binary missing"; exit 1; }
+          set -o pipefail
+          build/test_gui_offscreen.exe 2>&1 | tee build/gui_offscreen.log
+      - name: Package portable (fail closed, manifest asserted inside the script)
+        run: bash scripts/package_portable.sh build dist
+      - name: Assert package manifest (second, independent check)
+        run: bash scripts/assert_manifest.sh dist
+      - uses: actions/upload-artifact@v5
+        with:
+          name: app-windows-portable
+          path: dist/*.zip
+          if-no-files-found: error
+
+  package-smoke:
+    needs: windows
+    runs-on: windows-2022
+    timeout-minutes: 15
+    defaults: { run: { shell: bash } }
+    steps:
+      - uses: actions/download-artifact@v6
+        with: { name: app-windows-portable, path: smoke }
+      - name: Unpack and run one job from the package only (no checkout, no Qt install)
+        env: { QT_QPA_PLATFORM: offscreen }
+        run: |
+          cd smoke && unzip -q *.zip && cd */
+          ./app-cli.exe --version
+          ./app-cli.exe --help >/dev/null
+          # a real conversion against a fixture shipped in the zip, then verify output exists and is non-empty
diff --git a/coding-agents/variants/qt6-cmake-cpp/templates/logging.h b/coding-agents/variants/qt6-cmake-cpp/templates/logging.h
new file mode 100644
index 0000000..3603f1b
--- /dev/null
+++ b/coding-agents/variants/qt6-cmake-cpp/templates/logging.h
@@ -0,0 +1,137 @@
+// logging.h — per-module logging categories, a one-line structured message
+// handler, and a bounded ring buffer for crash records.
+//
+// Format (one line, greppable, no multi-line messages):
+//   2026-10-13T20:41:07.123Z tid=0x7f3a core.process INFO  engine started pid=4242 argv=[...]
+//
+// Install in main() right after QApplication:
+//   app::Logging::install(QStandardPaths::writableLocation(QStandardPaths::AppDataLocation) + "/app.log");
+// Then declare categories per MODULE (not per class) in one .cpp:
+//   Q_LOGGING_CATEGORY(lcCoreProcess, "core.process")
+//   Q_LOGGING_CATEGORY(lcUiMain,      "ui.main")
+// and use qCInfo(lcCoreProcess) << ...;
+//
+// Run-time control without a rebuild: QT_LOGGING_RULES="core.process.debug=true".
+// Crash record: app::Logging::tail(500) returns the last lines for a companion
+// text file (see references/crash-diagnosis.md §5).
+//
+// Header-only; depends on Qt Core. Written fresh for this skill (2026-10-13);
+// not compiled in the authoring sandbox — build it with the first project.
+
+#pragma once
+
+#include <QDateTime>
+#include <QFile>
+#include <QMutex>
+#include <QMutexLocker>
+#include <QString>
+#include <QStringList>
+#include <QTextStream>
+#include <QThread>
+#include <QtGlobal>
+
+#include <cstdio>
+#include <vector>
+
+namespace app {
+
+class Logging {
+ public:
+  // Install the handler. logPath may be empty (stderr + ring buffer only).
+  static void install(const QString& logPath = QString(), int ringCapacity = 1000) {
+    Logging& L = self();
+    QMutexLocker lock(&L.mutex_);
+    L.ring_.assign(static_cast<size_t>(ringCapacity), QString());
+    L.head_ = 0;
+    L.count_ = 0;
+    if (!logPath.isEmpty()) {
+      L.file_.setFileName(logPath);
+      if (!L.file_.open(QIODevice::Append | QIODevice::Text)) {
+        std::fprintf(stderr, "logging: cannot open %s\n", qPrintable(logPath));
+      }
+    }
+    L.previous_ = qInstallMessageHandler(&Logging::handler);
+  }
+
+  static void flush() {
+    Logging& L = self();
+    QMutexLocker lock(&L.mutex_);
+    if (L.file_.isOpen()) L.file_.flush();
+    std::fflush(stderr);
+  }
+
+  // Last n lines, oldest first. Safe to call from a crash handler only in the
+  // sense that it takes the mutex; if the crash happened while logging, this
+  // may block — call it from a watchdog thread or accept the risk.
+  static QStringList tail(int n = 500) {
+    Logging& L = self();
+    QMutexLocker lock(&L.mutex_);
+    QStringList out;
+    const int cap = static_cast<int>(L.ring_.size());
+    const int have = qMin(n, L.count_);
+    for (int i = have; i > 0; --i) {
+      int idx = (L.head_ - i + cap) % cap;
+      out << L.ring_[static_cast<size_t>(idx)];
+    }
+    return out;
+  }
+
+ private:
+  Logging() = default;
+  static Logging& self() {
+    static Logging instance;
+    return instance;
+  }
+
+  static const char* level(QtMsgType t) {
+    switch (t) {
+      case QtDebugMsg:    return "DEBUG";
+      case QtInfoMsg:     return "INFO ";
+      case QtWarningMsg:  return "WARN ";
+      case QtCriticalMsg: return "CRIT ";
+      case QtFatalMsg:    return "FATAL";
+    }
+    return "?????";
+  }
+
+  static void handler(QtMsgType type, const QMessageLogContext& ctx, const QString& msg) {
+    const QString line = QStringLiteral("%1 tid=0x%2 %3 %4 %5")
+        .arg(QDateTime::currentDateTimeUtc().toString(Qt::ISODateWithMs))
+        .arg(reinterpret_cast<quintptr>(QThread::currentThreadId()), 0, 16)
+        .arg(QString::fromLatin1(ctx.category ? ctx.category : "default"))
+        .arg(QString::fromLatin1(level(type)))
+        .arg(QString(msg).replace(QLatin1Char('\n'), QStringLiteral("\\n")));
+
+    Logging& L = self();
+    {
+      QMutexLocker lock(&L.mutex_);
+      if (!L.ring_.empty()) {
+        L.ring_[static_cast<size_t>(L.head_)] = line;
+        L.head_ = (L.head_ + 1) % static_cast<int>(L.ring_.size());
+        L.count_ = qMin(L.count_ + 1, static_cast<int>(L.ring_.size()));
+      }
+      if (L.file_.isOpen()) {
+        QTextStream ts(&L.file_);
+        ts << line << '\n';
+        if (type >= QtWarningMsg) ts.flush();
+      }
+    }
+    std::fprintf(stderr, "%s\n", qPrintable(line));
+
+    if (type == QtFatalMsg) {
+      // Write the crash record BEFORE Qt aborts. Hook your companion-file writer here.
+      flush();
+    }
+    // Do not chain to the previous handler for fatal messages: Qt's default
+    // aborts, and we want our flush to have happened first (it has, above).
+  }
+
+  QMutex mutex_;
+  std::vector<QString> ring_;
+  int head_ = 0;
+  int count_ = 0;
+  QFile file_;
+  QtMessageHandler previous_ = nullptr;
+};
+
+}  // namespace app
