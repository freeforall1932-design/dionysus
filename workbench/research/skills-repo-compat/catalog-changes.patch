+'''
+
+TEST_HARNESS_CPP = r'''
+#include <QApplication>
+#include <QProcess>
+#include <QTimer>
+#include <QFile>
+int main() {
+  QProcess p; p.waitForFinished(60000);           // fixture engine - fine in a harness
+  QCoreApplication::processEvents();              // pumping - fine in a harness
+  QTimer t; QObject::connect(&t, &QTimer::timeout, [] {});   // info only here
+  QFile f("scratch"); f.open(QIODevice::WriteOnly);
+  const char* fixture = "C:\\Users\\someone\\in.gif";    // path-handling fixture
+}
+'''
+
+COMMENT_PATH_CPP = r'''
+#include <QMainWindow>
+// a space in C:\Users\John Smith\in.gif used to split the argv  <- prose, must not fire
+/* also /home/someone/x in a block comment */
+class W : public QMainWindow {};
+'''
+
+EXPECT_BAD_CPP = {"QL001", "QL002", "QL003", "QL004", "QL005", "QL006", "QL007", "QL008", "QL009", "QL015"}
+EXPECT_BAD_CMAKE = {"QL011", "QL012", "QL013", "QL014", "QL015"}
+
+
+def selftest() -> int:
+    failures = 0
+
+    def check(cond: bool, what: str) -> None:
+        nonlocal failures
+        print(("ok   " if cond else "FAIL ") + what)
+        if not cond:
+            failures += 1
+
+    with tempfile.TemporaryDirectory() as d:
+        paths = {}
+        for name, body in (("bad/ui/w.cpp", BAD_CPP), ("clean/ui/w.cpp", CLEAN_CPP),
+                           ("bad/CMakeLists.txt", BAD_CMAKE), ("clean/CMakeLists.txt", CLEAN_CMAKE)):
+            full = os.path.join(d, name)
+            os.makedirs(os.path.dirname(full), exist_ok=True)
+            with open(full, "w", encoding="utf-8") as f:
+                f.write(body)
+            paths[name] = full
+
+        bad_cpp = {f.rule for f in lint_cpp(paths["bad/ui/w.cpp"], "bad/ui/w.cpp")}
+        for r in sorted(EXPECT_BAD_CPP):
+            check(r in bad_cpp, f"{r} fires on the bad C++ fixture")
+        check(not (bad_cpp - EXPECT_BAD_CPP), f"no unexpected C++ rule fired: {sorted(bad_cpp - EXPECT_BAD_CPP)}")
+
+        clean_cpp = lint_cpp(paths["clean/ui/w.cpp"], "clean/ui/w.cpp")
+        check(not clean_cpp, f"clean C++ fixture is silent: {[(f.rule, f.line) for f in clean_cpp]}")
+
+        bad_cm = {f.rule for f in lint_cmake(paths["bad/CMakeLists.txt"], "bad/CMakeLists.txt")}
+        for r in sorted(EXPECT_BAD_CMAKE):
+            check(r in bad_cm, f"{r} fires on the bad CMake fixture")
+        check(not (bad_cm - EXPECT_BAD_CMAKE), f"no unexpected CMake rule fired: {sorted(bad_cm - EXPECT_BAD_CMAKE)}")
+
+        clean_cm = lint_cmake(paths["clean/CMakeLists.txt"], "clean/CMakeLists.txt")
+        check(not clean_cm, f"clean CMake fixture is silent: {[(f.rule, f.line) for f in clean_cm]}")
+
+        # Mutation check: the inline allow must be the ONLY thing silencing QL003 in the clean fixture.
+        mutated = CLEAN_CPP.replace("// ql-allow QL003: bounded shutdown wait, measured and registered", "")
+        with open(paths["clean/ui/w.cpp"], "w", encoding="utf-8") as f:
+            f.write(mutated)
+        check(any(f.rule == "QL003" for f in lint_cpp(paths["clean/ui/w.cpp"], "clean/ui/w.cpp")),
+              "removing the ql-allow comment makes QL003 fire again (the guard can fail)")
+
+        # An allow without a reason must not suppress.
+        no_reason = CLEAN_CPP.replace("// ql-allow QL003: bounded shutdown wait, measured and registered", "// ql-allow QL003:")
+        with open(paths["clean/ui/w.cpp"], "w", encoding="utf-8") as f:
+            f.write(no_reason)
+        check(any(f.rule == "QL003" for f in lint_cpp(paths["clean/ui/w.cpp"], "clean/ui/w.cpp")),
+              "a ql-allow with an empty reason does not suppress")
+
+        # Test-file policy: only QL002 (as info) may fire on a harness.
+        tpath = os.path.join(d, "tests", "test_gui.cpp")
+        os.makedirs(os.path.dirname(tpath), exist_ok=True)
+        with open(tpath, "w", encoding="utf-8") as f:
+            f.write(TEST_HARNESS_CPP)
+        tf = lint_cpp(tpath, "tests/test_gui.cpp")
+        check({(x.rule, x.severity) for x in tf} == {("QL002", "info")},
+              f"test harness: only QL002/info fires: {[(x.rule, x.severity) for x in tf]}")
+
+        # A machine path in a comment is prose and must not fire.
+        cpath = os.path.join(d, "src", "ui", "c.cpp")
+        os.makedirs(os.path.dirname(cpath), exist_ok=True)
+        with open(cpath, "w", encoding="utf-8") as f:
+            f.write(COMMENT_PATH_CPP)
+        check(not [x for x in lint_cpp(cpath, "src/ui/c.cpp") if x.rule == "QL015"],
+              "QL015 ignores paths that appear only in comments")
+
+        # Baseline round trip: everything baselined -> zero new.
+        all_bad = lint_paths([os.path.join(d, "bad")])
+        base = {f.key() for f in all_bad}
+        check(all(f.key() in base for f in lint_paths([os.path.join(d, "bad")])), "baseline keys are stable across runs")
+
+    print(f"selftest: {'PASS' if failures == 0 else 'FAIL'} ({failures} failure(s))")
+    return 0 if failures == 0 else 1
+
+
+def main(argv: list[str]) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("paths", nargs="*", help="files or directories")
+    ap.add_argument("--json", action="store_true")
+    ap.add_argument("--baseline", help="JSON file of accepted finding keys")
+    ap.add_argument("--write-baseline", help="write current findings as the accepted baseline")
+    ap.add_argument("--fail-on", choices=["info", "warning", "error"], default="warning",
+                    help="exit 1 if a NON-baselined finding has at least this severity (default: warning)")
+    ap.add_argument("--selftest", action="store_true")
+    a = ap.parse_args(argv)
+
+    if a.selftest:
+        return selftest()
+    if not a.paths:
+        ap.error("give at least one path, or --selftest")
+
+    findings = lint_paths(a.paths)
+
+    if a.write_baseline:
+        # Writing a baseline IS the act of accepting today's findings: list them so the
+        # acceptance is visible in the log, then exit 0. Review the file before committing it.
+        keys = sorted({x.key() for x in findings})
+        with open(a.write_baseline, "w", encoding="utf-8") as f:
+            json.dump({"generated_by": "qt_lint.py", "keys": keys}, f, indent=2)
+        report(findings, a.json, set())
+        print(f"qt_lint: wrote baseline with {len(keys)} key(s) for {len(findings)} finding(s) to {a.write_baseline} "
+              f"- review it, then commit it next to the project's CI config")
+        return 0
+
+    baseline: set[str] = set()
+    if a.baseline:
+        with open(a.baseline, encoding="utf-8") as f:
+            baseline = set(json.load(f).get("keys", []))
+
+    report(findings, a.json, baseline)
+
+    threshold = SEVERITY_ORDER[a.fail_on]
+    bad = [f for f in findings if f.key() not in baseline and SEVERITY_ORDER.get(f.severity, 0) >= threshold]
+    if not a.json:
+        sm = summary(findings, baseline)
+        print(f"qt_lint: {sm['total']} finding(s) ({', '.join(f'{k}: {v}' for k, v in sm['by_severity'].items()) or 'none'}); "
+              f"{sm['new']} not in baseline; {len(bad)} at or above --fail-on={a.fail_on} -> exit {1 if bad else 0}")
+    return 1 if bad else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/coding-agents/variants/qt6-cmake-cpp/templates/CMakeLists.txt b/coding-agents/variants/qt6-cmake-cpp/templates/CMakeLists.txt
new file mode 100644
index 0000000..9117dd7
--- /dev/null
+++ b/coding-agents/variants/qt6-cmake-cpp/templates/CMakeLists.txt
@@ -0,0 +1,139 @@
+# Qt 6 / CMake skeleton — cross-platform (Linux gcc/clang, Windows MinGW/MSVC, macOS).
+#
+# Shape:
+#   app_core            Qt-free (or Qt Core only) library: settings, validation,
+#                       argv builder, planners, verifiers — testable without a GUI.
+#   MyApp               the Qt Widgets GUI (WIN32 + MACOSX_BUNDLE so no console
+#                       window appears and macOS gets an .app).
+#   test_core           plain C++ test executable for app_core.
+#   test_gui_offscreen  real widgets under QT_QPA_PLATFORM=offscreen.
+#   fake_engine_*       tiny fixture executables the GUI harness launches.
+#
+# Qt is located through CMAKE_PREFIX_PATH (see CMakePresets.json: it reads the
+# QT_PREFIX environment variable). No machine path lives in this file.
+#
+# STATUS: written 2026-10-13 without a Qt 6 or CMake installation at hand —
+# NOT compiled yet. First use: configure from a fresh build dir, fix what the
+# real toolchain reports, and record the result in the project overlay.
+
+cmake_minimum_required(VERSION 3.21)
+
+# ---- single version source: VERSION file, generated header in the BUILD tree only
+file(READ "${CMAKE_CURRENT_SOURCE_DIR}/VERSION" _app_version_raw)
+string(STRIP "${_app_version_raw}" APP_VERSION)
+if(NOT APP_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+")
+  message(FATAL_ERROR "VERSION must contain MAJOR.MINOR.PATCH, got '${APP_VERSION}'")
+endif()
+
+project(MyApp VERSION ${APP_VERSION} LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_CXX_EXTENSIONS OFF)
+
+option(BUILD_GUI    "Build the Qt 6 Widgets GUI"             ON)
+option(ENABLE_ASAN  "AddressSanitizer (gcc/clang/MSVC)"      OFF)
+option(ENABLE_UBSAN "UndefinedBehaviorSanitizer (gcc/clang)" OFF)
+option(WARNINGS_AS_ERRORS "Treat warnings as errors (CI)"    OFF)
+
+configure_file(cmake/version.h.in "${CMAKE_BINARY_DIR}/generated/app/version.h" @ONLY)
+
+# ---- diagnostics flags (applied to every target below via an INTERFACE lib)
+add_library(app_flags INTERFACE)
+if(MSVC)
+  target_compile_options(app_flags INTERFACE /W4 /permissive- /utf-8)
+  if(WARNINGS_AS_ERRORS)
+    target_compile_options(app_flags INTERFACE /WX)
+  endif()
+  if(ENABLE_ASAN)
+    target_compile_options(app_flags INTERFACE /fsanitize=address)
+    target_link_options(app_flags INTERFACE /INCREMENTAL:NO)
+  endif()
+else()
+  target_compile_options(app_flags INTERFACE -Wall -Wextra -Wpedantic -Wshadow)
+  if(WARNINGS_AS_ERRORS)
+    target_compile_options(app_flags INTERFACE -Werror)
+  endif()
+  if(ENABLE_ASAN)
+    target_compile_options(app_flags INTERFACE -fsanitize=address -fno-omit-frame-pointer)
+    target_link_options(app_flags INTERFACE -fsanitize=address)
+  endif()
+  if(ENABLE_UBSAN)
+    target_compile_options(app_flags INTERFACE -fsanitize=undefined -fno-omit-frame-pointer)
+    target_link_options(app_flags INTERFACE -fsanitize=undefined)
+  endif()
+endif()
+
+# ---- core library: no Qt dependency so a Qt-less runner still pins the logic
+add_library(app_core STATIC
+  src/core/Settings.cpp
+  src/core/Command.cpp
+)
+target_include_directories(app_core PUBLIC
+  "${CMAKE_BINARY_DIR}/generated"   # generated FIRST so a committed fallback never wins
+  src
+)
+target_link_libraries(app_core PUBLIC app_flags)
+
+# ---- tests (always built; the GUI harness is added below when Qt exists)
+enable_testing()
+
+add_executable(test_core tests/test_core.cpp)
+target_link_libraries(test_core PRIVATE app_core)
+add_test(NAME core COMMAND test_core)
+
+# Fixture engines the GUI harness launches for real (see subprocess-engine.md §10).
+add_executable(fake_engine_ok   tests/fake_engine_ok.cpp)
+add_executable(fake_engine_fail tests/fake_engine_fail.cpp)
+target_link_libraries(fake_engine_ok   PRIVATE app_flags)
+target_link_libraries(fake_engine_fail PRIVATE app_flags)
+
+# ---- GUI (optional, honest skip)
+if(BUILD_GUI)
+  find_package(Qt6 6.4 COMPONENTS Widgets QUIET)
+  if(Qt6_FOUND)
+    message(STATUS "Qt6 ${Qt6_VERSION} found -> building GUI")
+    qt_standard_project_setup()
+
+    qt_add_executable(MyApp WIN32 MACOSX_BUNDLE
+      src/main.cpp
+      src/ui/MainWindow.cpp
+      src/ui/MainWindow.h
+    )
+    target_link_libraries(MyApp PRIVATE app_core Qt6::Widgets)
+
+    qt_add_executable(test_gui_offscreen
+      tests/test_gui_offscreen.cpp
+      src/ui/MainWindow.cpp
+      src/ui/MainWindow.h
+    )
+    target_link_libraries(test_gui_offscreen PRIVATE app_core Qt6::Widgets)
+    # Every fixture the harness launches must be a dependency, or a
+    # `--target test_gui_offscreen` build leaves it missing at run time.
+    add_dependencies(test_gui_offscreen fake_engine_ok fake_engine_fail)
+    add_test(NAME gui_offscreen COMMAND test_gui_offscreen)
+    set_tests_properties(gui_offscreen PROPERTIES
+      ENVIRONMENT "QT_QPA_PLATFORM=offscreen"
+      TIMEOUT 600)
+
+    # Deployment hook: `cmake --install` runs windeployqt/macdeployqt logic.
+    install(TARGETS MyApp BUNDLE DESTINATION . RUNTIME DESTINATION bin)
+    qt_generate_deploy_app_script(TARGET MyApp OUTPUT_SCRIPT _deploy_script
+                                  NO_UNSUPPORTED_PLATFORM_ERROR)
+    install(SCRIPT ${_deploy_script})
+  else()
+    message(STATUS "Qt6 NOT found -> GUI skipped. Set CMAKE_PREFIX_PATH (or QT_PREFIX for the presets).")
+  endif()
+endif()
+
+# ---- MinGW: self-contained non-Qt executables (no libstdc++-6.dll etc. on a clean machine)
+if(MINGW)
+  foreach(t test_core fake_engine_ok fake_engine_fail)
+    target_link_options(${t} PRIVATE -static)
+  endforeach()
+  foreach(t MyApp test_gui_offscreen)
+    if(TARGET ${t})
+      target_link_options(${t} PRIVATE -static-libgcc -static-libstdc++)
+    endif()
+  endforeach()
+endif()
